# Kosongkan jika menggunakan satu domain terpadu (Nginx reverse proxy) atau Vite dev proxy
VITE_API_BASE_URL=

# Set ke true hanya jika ingin menjalankan frontend secara offline dengan Mock Service Worker (MSW)
VITE_USE_MOCKS=false

# Set ke true hanya jika ingin menampilkan kotak petunjuk akun demo di halaman Login
VITE_SHOW_DEMO_HINT=false
